{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuck",
  "version": "0.0.1",
  "identifier": "com.felipecepluki.tuck",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tuck",
        "width": 640,
        "height": 520,
        "minWidth": 420,
        "minHeight": 380,
        "decorations": true,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
